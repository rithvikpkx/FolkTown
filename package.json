{
  "name": "folktown",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter @folktown/client dev",
    "saltline": "pnpm --filter @folktown/saltline dev",
    "saltline:walk-build": "node tools/saltline-walk-build.mjs",
    "build": "pnpm -r build",
    "bench": "node tools/bench.mjs",
    "shoot": "node tools/shoot.mjs",
    "test": "vitest run",
    "lint": "biome check . && pnpm -r typecheck",
    "map:fetch": "pnpm --filter @folktown/map-tools run fetch-osm",
    "map:project": "pnpm --filter @folktown/map-tools run project",
    "map:bake": "pnpm --filter @folktown/map-tools run bake",
    "map:heights": "pnpm --filter @folktown/map-tools run heights",
    "map:pilot-ortho": "uv run --with pillow --with pyproj python packages/map-tools/src/pilot-ortho.py",
    "map:pilot-roofs": "uv run --with rasterio --with numpy --with 'laspy[lazrs]' --with pyproj --with scipy --with shapely python packages/map-tools/src/pilot-roofs.py",
    "map:tiles": "pnpm --filter @folktown/map-tools run tiles",
    "map:tiles:convert": "pnpm --filter @folktown/map-tools run tiles-convert",
    "map:streetview": "pnpm --filter @folktown/map-tools run streetview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
